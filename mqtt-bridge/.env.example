# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://192.168.137.247
# Recommended: enable auth on your broker (e.g. mosquitto password_file)
MQTT_USERNAME=
MQTT_PASSWORD=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Must match the MQTT_WEBHOOK_SECRET function secret
MQTT_WEBHOOK_SECRET=generate-a-long-random-string

# Local API server (api-server.js)
API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated origins allowed to call the local API
API_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
